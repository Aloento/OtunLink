<!doctype html><html><meta charset="utf-8"><head><style>
*{margin:0;padding:0;box-sizing:border-box}
body{width:1080px;height:1350px;overflow:hidden;font-family:"Microsoft YaHei",sans-serif;
background:radial-gradient(1200px 700px at 80% -10%, #D6412F 0%, #B3242B 45%, #8E1B22 100%);color:#FFF6E8;
padding:54px 58px;display:flex;flex-direction:column}
.hl{display:flex;align-items:center;gap:18px}
.logo{width:80px;height:80px;border-radius:20px;display:block}
.brand{font-size:27px;letter-spacing:5px;color:#FFD79A;font-weight:700;line-height:1.35}
.h1{font-size:56px;font-weight:900;margin-top:10px;line-height:1.2}
.h1 em{font-style:normal;color:#FFC94D}
.sub{font-size:30px;color:#FFD79A;margin-top:8px}
.list{margin-top:22px;background:rgba(255,246,232,0.97);border-radius:24px;padding:10px 26px;color:#24120F}
.row{display:flex;align-items:center;height:84px;border-bottom:1px solid rgba(0,0,0,0.08)}
.row:last-child{border-bottom:none}
.c{width:78px;font-size:29px;font-weight:900;color:#B3242B}
.nm{flex:1;font-size:38px;font-weight:700}
.n{width:118px;font-size:28px;color:#7A5A50;text-align:right;padding-right:20px}
.p{width:176px;font-size:44px;font-weight:900;text-align:right;color:#B3242B}
.ok{width:142px;text-align:center;font-size:27px;font-weight:800;color:#0F5132;background:#D8F3DC;border-radius:10px;padding:6px 0}
.no{width:142px}
.foot{margin-top:auto;display:flex;justify-content:space-between;font-size:30px;color:#FFD79A}
</style></head><body>
<div class="hl"><img class="logo" src="{{LOGO}}"><div class="brand">欧囤囤 OTUNLINK<br>11.11 双十一</div></div>
<div class="h1">10 个套餐，整箱开卖<br><em>2,990 起</em></div>
<div class="sub">整箱买，比一件件买省 900 – 6,324</div>
<div class="list">{{ROWS}}</div>
<div class="foot"><span>11.09 – 11.15 · 每包限量</span><span style="opacity:.72;font-size:25px">价格单位 HUF</span></div>
</body></html>
