{
  "name": "@otunlink/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --config wrangler.local.toml",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@otunlink/db": "workspace:*",
    "@otunlink/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "postgres": "^4.0.0",
    "worker-mailer": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/nodemailer": "^8.0.2",
    "nodemailer": "^10.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
