    "aws4fetch": "^1.0.20",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "postgres": "^3.4.9",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
