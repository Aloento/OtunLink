{
  "name": "otunlink",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @otunlink/api dev",
    "dev:api:local": "pnpm --filter @otunlink/api dev:local",
    "dev:web": "pnpm --filter @otunlink/web dev",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:ui": "bash scripts/check-ui-stack.sh",
    "smoke:sql": "node scripts/smoke-sql.mjs"
  }
}
