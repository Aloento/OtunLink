# ── PostgreSQL（本地开发直连；生产走 Cloudflare Hyperdrive）────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/otunlink

# ── Azure AD / Entra ID（单租户 OAuth）─────────────────────────────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_SCOPE=api://<client-id>/OtunLink.API

# ── Cloudflare 部署（CI / wrangler deploy 使用）────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── 邮件（自建域名邮箱 HTTP↔SMTP 桥，见 design.md §8.8）───────────────────
MAIL_PROVIDER=bridge
MAIL_FROM=noreply@otunlink.com
MAIL_BRIDGE_URL=
MAIL_BRIDGE_API_KEY=
