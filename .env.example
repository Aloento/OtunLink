# ── PostgreSQL（本地开发直连；生产走 Cloudflare Hyperdrive）────────────────
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/otunlink

# ── Azure AD / Entra ID（单租户 OAuth，见 docs/auth-setup.md）──────────────
# 前端（Vite，写入 apps/web/.env.local）：
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# 可选：覆盖默认重定向地址（生产 https://otun.musi.land/auth/callback；开发 http://localhost:5173/auth/callback）
VITE_REDIRECT_URI=
# 可选：覆盖默认 API scope api://<client-id>/OtunLink.API
VITE_API_SCOPE=api://<client-id>/OtunLink.API
# 可选：API 基地址（默认 http://localhost:8787）
VITE_API_BASE_URL=

# 后端（Worker，写入 apps/api/.dev.vars）：
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_CLIENT_SECRET=

# ── Cloudflare 部署（CI / wrangler deploy 使用）────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── 邮件（SMTP 直连）────────────────────────────────────────────────────
# MAIL_PROVIDER=smtp（默认）；适配器：smtp（Worker 直连外部 SMTP）/ api（预留）。
# 飞书 Lark：SMTP <SMTP_HOST>，仅 465（SSL）/587（STARTTLS），发信人 <MAIL_FROM>，
# 发信频率 200 封/100 秒，单发件人单日上限 450 封。
MAIL_PROVIDER=smtp
MAIL_FROM=<MAIL_FROM>
# SMTP_SECURE=true 走 465 隐式 TLS，否则 SMTP_STARTTLS=true 走 587 STARTTLS。
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_AUTH=plain
