# 本地开发用：复制为 apps/api/.dev.vars（已被 .gitignore 忽略，勿提交真实值）。
# wrangler dev 会自动读取 apps/api/.dev.vars。

# ── 本地 PostgreSQL（本地开发直连；生产走 Hyperdrive binding）────────────
# DATABASE_URL=postgresql://user:password@host:5432/otunlink

# ── Azure AD / Entra ID（单租户，见 docs/auth-setup.md）──────────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# 可选：显式 audience（默认接受 CLIENT_ID；也可设为 api://<client-id>/OtunLink.API）
ENTRA_AUDIENCE=
# 可选：JWT issuer 覆盖（默认 https://login.microsoftonline.com/<TENANT_ID>/v2.0）
ENTRA_ISSUER=
# 可选：客户端密码（服务端仅验签、不发起机密客户端请求，可不填）
ENTRA_CLIENT_SECRET=

# ── S3 兼容对象存储（华为云 OBS，见 docs/cloud-config.md）─────────────────
# endpoint/region/bucket 已在 wrangler.toml [vars]，此处只需凭据
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 邮件（SMTP 直连）────────────────────────────────────────────────────
# 非敏感配置（SMTP_HOST/MAIL_FROM/端口等）已在 wrangler.toml [vars]；
# SMTP_USER/SMTP_PASS 为 secret，本地写 .dev.vars、生产经 wrangler secret put。
# 飞书 Lark：SMTP_USER 为发信账号，SMTP_PASS 为邮箱授权码/密码。不配则降级为仅站内通知。
SMTP_USER=
SMTP_PASS=
